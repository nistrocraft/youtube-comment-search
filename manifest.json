{
  "manifest_version": 3,
  "name": "YouTube Comment Search",
  "version": "1.0.0",
  "description": "Search through all comments on a YouTube video, including replies.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["src/fetcher.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
